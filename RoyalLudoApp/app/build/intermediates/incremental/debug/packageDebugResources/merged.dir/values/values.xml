<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="colorAccent">#F4CB45</color>
    <color name="colorPrimary">#F4CB45</color>
    <color name="colorPrimaryDark">#E9A825</color>
    <color name="splashBackground">#0e1220</color>
    <color name="white">#FFFFFF</color>
    <string name="app_name">Royal Ludo Club</string>
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/splashBackground</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
        
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
    </style>
    <style name="SplashTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/splashBackground</item>
        <item name="android:statusBarColor">@color/splashBackground</item>
    </style>
</resources>